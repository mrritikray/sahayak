# SAHAYAK environment file.
# Copy this file to ".env" in the same folder, then edit it. Never commit your real .env.

# ---------------------------------------------------------------------------
# LOCAL DEMO MODE (no API keys, no paid service, nothing leaves your PC)
# ---------------------------------------------------------------------------
DEMO_MODE=true
COOKIE_SECURE=false

# Run the scheduler inside the web process too, so a single window is enough.
# "false" (recommended) keeps the scheduler in its own window: see README.
SCHEDULER_IN_APP=false
SCHEDULER_TICK_SECONDS=15

# A random session key is generated and stored privately in instance/secret.key
# when SECRET_KEY is absent. Never commit your real .env or the instance/ folder.
# SECRET_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# REAL WHATSAPP (optional - leave everything empty for the free local demo)
# Never paste these values into chat, screenshots or Git.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Not needed for outbound messages. Required only for inbound replies and delivery callbacks.
# Must be the current public HTTPS tunnel URL (without a path), not localhost.
# PUBLIC_BASE_URL=https://your-current-tunnel-host

# ---------------------------------------------------------------------------
# Optional: BEFORE your first real WhatsApp test, use a NEW database file so your
# demo history stays separate from live messages.
# ---------------------------------------------------------------------------
# DATABASE_PATH=instance/live.sqlite3
# DEMO_MODE=false
# COOKIE_SECURE=true
# PUBLIC_BASE_URL=https://your-current-tunnel-host
# TWILIO_WHATSAPP_FROM=whatsapp:copy-the-sandbox-number-from-your-own-console
